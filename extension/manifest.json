{
  "manifest_version": 3,
  "name": "OLWLG Beautifier",
  "short_name": "OLWLG",
  "version": "1.0.2",
  "description": "A calmer, clearer interface for the OLWLG math trade tools.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://bgg.activityclub.org/olwlg/*"],
  "action": {
    "default_title": "OLWLG Beautifier",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://bgg.activityclub.org/olwlg/*"],
      "css": ["content/beautifier.css"],
      "js": ["content/beautifier.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg"],
      "matches": ["https://bgg.activityclub.org/*"]
    }
  ]
}
